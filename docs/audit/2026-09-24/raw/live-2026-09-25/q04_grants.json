{
 "query": "select r.rolname as grantee, c.relname as table_name, concat_ws(',', case when has_table_privilege(r.oid,c.oid,'SELECT') then 'SELECT' end, case when has_table_privilege(r.oid,c.oid,'INSERT') then 'INSERT' end, case when has_table_privilege(r.oid,c.oid,'UPDATE') then 'UPDATE' end, case when has_table_privilege(r.oid,c.oid,'DELETE') then 'DELETE' end, case when has_table_privilege(r.oid,c.oid,'TRUNCATE') then 'TRUNCATE' end) as privileges from pg_class c join pg_namespace n on n.oid=c.relnamespace cross join pg_roles r where n.nspname='public' and c.relkind in ('r','v','m') and r.rolname in ('anon','authenticated') order by c.relname, r.rolname",
 "http_status": "201",
