# Copy to .env and fill in values from your Supabase project settings.
# Never commit the resulting .env file (.gitignore covers it -- keep it that way).
#
# This file holds PLACEHOLDERS ONLY. Never paste a real value here: it is
# tracked, so a value typed in "just to test" ships to everyone who clones.
#
# SUPABASE_ACCESS_TOKEN and VERCEL_TOKEN are deliberately absent below and must
# not be added. They are account-level deploy credentials, not build inputs --
# a local build never needs them. Supply them as session environment variables
# at deploy time only. See "Deployment credentials never enter the repository"
# in CLAUDE.md.

# --- Client-side (exposed to the browser via the Vite bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public origin the ID card's QR code points at. Must be the URL the public
# can actually reach - a card printed from localhost with this unset would
# carry an unopenable QR. Defaults to the production URL when unset.
VITE_PUBLIC_SITE_URL=

# --- Server-side ---
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# Service role key: bypasses RLS. Server-only, never expose to the client.
# Required by src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY=
