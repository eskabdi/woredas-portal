# Copy to .env and fill in values from your Supabase project settings.
# Never commit the resulting .env file.

# --- Client-side (exposed to the browser via the Vite bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public origin the ID card's QR code points at. Must be the URL the public
# can actually reach - a card printed from localhost with this unset would
# carry an unopenable QR. Defaults to the production URL when unset.
VITE_PUBLIC_SITE_URL=

# --- Server-side ---
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

# Service role key: bypasses RLS. Server-only, never expose to the client.
# Required by src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY=
